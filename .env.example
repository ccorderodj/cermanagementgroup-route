# =============================================================================
# CER application foundation — plantilla de configuración
# =============================================================================
# Copiar a `.env` y rellenar. NUNCA versionar el `.env` resultante.
#
#   cp .env.example .env                      (bash)
#   Copy-Item .env.example .env               (PowerShell)
#
# `app/config.py` valida estos valores al arrancar y el proceso NO levanta si
# falta alguno de los obligatorios o si SECRET_KEY es un placeholder conocido.
# =============================================================================

# --- Identidad del proyecto --------------------------------------------------
# Cómo se llama esta aplicación. Plantillas y shell de React leen estos valores;
# no hace falta tocar código para rebautizarla.
APP_NAME=CER Route
APP_TITLE=CER Route
APP_BRAND_LABEL=CER Management Group
APP_BRAND_TAGLINE=
APP_LOGO_PATH=/static/img/cer-logo.svg
APP_ICON_PATH=/static/img/cer-icon.svg
# Banda de entorno del shell. Vacío = se deriva de MODE (DEV y TEST la muestran).
ENVIRONMENT_NAME=
# Adónde va un usuario autenticado que abre `/` o `/login`.
DEFAULT_AUTHENTICATED_PATH=/admin

# --- Entorno -----------------------------------------------------------------
# DEV  | TEST | PROD
#   DEV  habilita /api/docs (Swagger). En TEST y PROD queda deshabilitada salvo
#        que se ponga ENABLE_API_DOCS=true de forma explícita.
MODE=DEV
LOG_LEVEL=INFO

# Dominio base para resolver la compañía por subdominio.
# La aplicación exige `<subdominio>.<BASE_DOMAIN>`: con `localhost` se entra por
# http://cer.localhost:8000 — nunca por http://localhost:8000.
BASE_DOMAIN=localhost

# --- Base de datos (PostgreSQL 14 o superior) --------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=cer_app
DB_PASS=
DB_NAME=cer_app

# Solo para despliegue en Cloud SQL. Vacío en local.
DB_CLOUDSQL_CONNECTION_NAME=

# Modo TLS de la conexión. **Vacío en local**: el PostgreSQL del
# `docker-compose` no ofrece TLS y exigirlo impediría arrancar.
#
# En una base gestionada accesible por internet, ponlo en `require` como mínimo.
# Sin esto la conexión viaja sin cifrar, y una base gestionada suele aceptarla
# por la red interna y rechazarla desde fuera —lo que hace que el fallo aparezca
# sólo en algunos caminos, como un job de despliegue—.
#
# Valores: los de libpq (`require`, `verify-ca`, `verify-full`).
DB_SSL=

# Conexiones máximas que ESTE PROCESO puede abrir a la vez (pool_size + max_overflow).
# Multiplícalo por réplicas/workers y deja margen: el total no puede superar el
# max_connections del plan de base de datos.
DB_POOL_SIZE=3
DB_POOL_MAX_OVERFLOW=2

# Base de datos que usan los tests de integración (MODE=TEST).
# Debe ser una base DISTINTA de DB_NAME: la suite la borra y la recrea.
TEST_DATABASE_URL=postgresql+asyncpg://cer_app:CAMBIAR@localhost:5432/cer_app_test

# --- Seguridad ---------------------------------------------------------------
# Clave de firma de los JWT de sesión (HS256). Mínimo 32 caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes permitidos por CORS, separados por comas. Vacío = ninguno.
CORS_ORIGINS=

# Exponer /metrics. En PROD debería publicarse solo por red interna.
ENABLE_METRICS=true

# Forzar la documentación OpenAPI fuera de MODE=DEV.
ENABLE_API_DOCS=false

# --- OCR del odómetro (RTE10-A01) --------------------------------------------
# Si se intenta leer la lectura de la foto. El OCR es ASISTIVO: sugiere, y la
# autoridad sigue siendo la confirmación del supervisor.
#
# En `true` el arranque enchufa el lector solo si el binario existe. Sin el
# paquete de sistema (`tesseract-ocr`, ver `Aptfile`) no hay sugerencias y el
# supervisor teclea la lectura, que es el camino normal y suficiente.
ODOMETER_OCR_ENABLED=true
ODOMETER_OCR_BINARY=tesseract
# Lo máximo que el supervisor espera por una sugerencia. Pasado el plazo el
# proceso se mata y la foto sigue su camino sin ella.
ODOMETER_OCR_TIMEOUT_SECONDS=8.0

# Minutos que se conserva la FOTOGRAFIA del odometro. 0 = para siempre.
#
# Existe por una limitacion de entorno, no por preferencia: donde el disco del
# contenedor es efimero y no hay almacenamiento de objetos, la foto se pierde
# igualmente en el siguiente despliegue, y purgarla a proposito al menos acota
# el disco y hace que la desaparicion sea una regla conocida.
#
# COSTE: pasado el plazo, una evidencia `photo_confirmed` sigue diciendo que
# hay fotografia y la fotografia ya no esta. Por eso el valor por defecto es 0:
# un entorno con almacenamiento duradero no debe heredar esto por descuido.
ODOMETER_PHOTO_RETENTION_MINUTES=0

# --- Correo (recuperación de contraseña y avisos) ----------------------------
# console | memory | smtp. Los proveedores de producción (M365, SMTP) se
# configuran también desde Platform › Integrations & Settings.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_MINUTES=60

# --- Archivos subidos --------------------------------------------------------
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/heic,image/heif,image/webp,application/pdf
UPLOAD_MAX_BYTES=10485760
# Raíz del almacén LOCAL de desarrollo. Vacío = ./var/storage
STORAGE_ROOT=

# --- Integración entre aplicaciones (docs/INTEGRATION_GUIDE.md) -------------
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=6
IDEMPOTENCY_TTL_HOURS=24

# --- Almacén de secretos de plataforma ---------------------------------------
# Cifra credenciales de integraciones y secretos de webhooks. Generar con:
#   python -m app.core.platform.secrets generate
# Guardarla también fuera de línea: sin ella los secretos no se descifran.
PLATFORM_MASTER_KEY=
PLATFORM_MASTER_KEY_PREVIOUS=

# Planificador: chequeos, entregas de webhooks y avisos.
PLATFORM_SCHEDULER_ENABLED=true

# --- Siembra inicial (app/db/scripts/bootstrap.py) ---------------------------
BOOTSTRAP_COMPANY_NAME=CER Management Group LLC
BOOTSTRAP_COMPANY_SUBDOMAIN=cer
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_STATES=GA
BOOTSTRAP_MAIN_STATE=
# Vacío = se genera y se muestra una sola vez.
ADMIN_PASSWORD=
